FROM ubuntu:24.04 AS build

RUN apt-get update && apt-get install -y \
    build-essential cmake git \
    libjsoncpp-dev uuid-dev zlib1g-dev \
    openssl libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY api/ .
RUN mkdir build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Release && make -j$(nproc)

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y libssl3 libjsoncpp25 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/build/drivex_api /usr/local/bin/drivex_api
COPY api/config/config.prod.json /etc/drivex/config.json
EXPOSE 8080
CMD ["drivex_api", "--config", "/etc/drivex/config.json"]
